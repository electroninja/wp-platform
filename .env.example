WP_HOME=http://localhost:8080
WP_SITEURL=${WP_HOME}/wp
WP_ENV=development

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
DB_HOST=mariadb

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme_admin
WP_ADMIN_EMAIL=you@example.com

WP_REDIS_HOST=redis
WP_REDIS_PORT=6379

# Generate real values for these — never reuse the placeholders:
# curl https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=generate-me
SECURE_AUTH_KEY=generate-me
LOGGED_IN_KEY=generate-me
NONCE_KEY=generate-me
AUTH_SALT=generate-me
SECURE_AUTH_SALT=generate-me
LOGGED_IN_SALT=generate-me
NONCE_SALT=generate-me
